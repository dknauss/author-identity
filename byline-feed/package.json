{
	"name": "byline-feed",
	"version": "0.1.0",
	"description": "Byline Feed WordPress plugin",
	"private": true,
	"scripts": {
		"build": "wp-scripts build src/perspective-panel.tsx src/ai-consent-panel.tsx src/author-mode-panel.tsx --output-path=build",
		"start": "wp-scripts start src/perspective-panel.tsx src/ai-consent-panel.tsx src/author-mode-panel.tsx --output-path=build",
		"postinstall": "node bin/patch-wordpress-env.js",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:setup": "bash bin/setup-e2e.sh",
		"test:e2e": "bash bin/run-e2e.sh",
		"test:e2e:headed": "PLAYWRIGHT_HEADLESS=0 bash bin/run-e2e.sh"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@wordpress/env": "12.0.0",
		"@wordpress/scripts": "^37.0.0",
		"@types/wordpress__plugins": "^6.0.0",
		"@types/wordpress__components": "^23.8.0"
	},
	"overrides": {
		"copy-webpack-plugin": {
			"serialize-javascript": "7.1.4"
		},
		"@sentry/node": {
			"minimatch": "9.0.7"
		},
		"@typescript-eslint/typescript-estree": {
			"minimatch": "9.0.7"
		},
		"markdownlint-cli": {
			"minimatch": "3.1.5"
		},
		"extract-zip": {
			"yauzl": "3.2.1"
		},
		"webpack-dev-server": "5.2.6",
		"adm-zip": "0.6.1",
		"brace-expansion": "2.1.7",
		"js-yaml": "4.3.2",
		"linkify-it": "5.0.2",
		"markdown-it": "14.3.3",
		"uuid": "11.1.1",
		"body-parser": "1.20.9",
		"katex": "0.18.11",
		"qs": "6.17.1",
		"smol-toml": "1.9.1"
	}
}
